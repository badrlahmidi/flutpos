<![CDATA[<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample data extraction rules file; disables ADB backup and data extraction
   to prevent copying the local SQLite database (security fix [HAUTE-M01]).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
]]>